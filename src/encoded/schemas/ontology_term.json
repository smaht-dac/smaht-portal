{
    "title": "Ontology Term",
    "$id": "/profiles/ontology_term.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "identifier",
        "title",
        "ontologies"
    ],
    "anyOf": [
        {
            "required": [
                "submission_centers"
            ]
        },
        {
            "required": [
                "consortia"
            ]
        }
    ],
    "identifyingProperties": [
        "aliases",
        "identifier",
        "uuid"
    ],
    "additionalProperties": false,
    "mixinProperties": [
        {
            "$ref": "mixins.json#/aliases"
        },
        {
            "$ref": "mixins.json#/attribution"
        },
        {
            "$ref": "mixins.json#/description"
        },
        {
            "$ref": "mixins.json#/identifier"
        },
        {
            "$ref": "mixins.json#/modified"
        },
        {
            "$ref": "mixins.json#/preferred_name"
        },
        {
            "$ref": "mixins.json#/schema_version"
        },
        {
            "$ref": "mixins.json#/status"
        },
        {
            "$ref": "mixins.json#/submitted"
        },
        {
            "$ref": "mixins.json#/tags"
        },
        {
            "$ref": "mixins.json#/title"
        },
        {
            "$ref": "mixins.json#/url"
        },
        {
            "$ref": "mixins.json#/uuid"
        }
    ],
    "properties": {
        "identifier": {
            "pattern": "^[A-Z]+:[0-9]+$"
        },
        "title": {
            "description": "Title of the ontology term"
        },
        "schema_version": {
            "default": "1"
        },
        "status": {
            "default": "open",
            "enum": [
                "released",
                "open",
                "in review",
                "obsolete",
                "deleted"
            ]
        },
        "description": {
            "description": "Description of the ontology term"
        },
        "ontologies": {
            "title": "Ontologies",
            "description": "Ontologies that this term is a part of",
            "type": "array",
            "items": {
                "type": "string",
                "linkTo": "Ontology"
            }
        },
        "url": {
            "description": "The url that uniquely identifies term - often purl."
        },
        "grouping_term": {
            "title": "Grouping Term",
            "description": "Ontology term that this term is grouped under - less specific term used in search",
            "type": "string",
            "linkTo": "OntologyTerm"
        },
        "valid_protocol_ids":{
            "title": "Valid Protocol IDs",
            "description": "Tissue protocol IDs that are valid for the ontology term - used to check that Uberon IDs are correctly linked to tissue items.",
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "standardized_recovery_description": {
            "title": "Standardized Recovery Description",
            "description": "Canonical description of the standardized tissue recovery location.",
            "type": "string"
        },
        "initial_tissue_configuration": {
            "title": "Initial Tissue Configuration",
            "description": "Curated description of the tissue configuration before aliquoting.",
            "type": "string"
        },
        "frozen_aliquot_specification": {
            "title": "Frozen Aliquot Specification",
            "description": "Source-specified count, scope, and dimensions for frozen aliquots.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "count",
                "count_scope",
                "dimensions_cm"
            ],
            "properties": {
                "count": {
                    "type": "integer",
                    "minimum": 1
                },
                "count_scope": {
                    "type": "string",
                    "enum": [
                        "per organ",
                        "per tissue",
                        "per half"
                    ]
                },
                "total_count": {
                    "type": "integer",
                    "minimum": 1
                },
                "total_scope": {
                    "type": "string",
                    "enum": [
                        "per organ",
                        "per bilateral organ"
                    ]
                },
                "dimensions_cm": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "length",
                        "width",
                        "full_thickness"
                    ],
                    "properties": {
                        "length": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "width": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "depth": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "full_thickness": {
                            "type": "boolean"
                        }
                    },
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "full_thickness": {
                                        "const": true
                                    }
                                }
                            },
                            "then": {
                                "not": {
                                    "required": [
                                        "depth"
                                    ]
                                }
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "full_thickness": {
                                        "const": false
                                    }
                                }
                            },
                            "then": {
                                "required": [
                                    "depth"
                                ]
                            }
                        }
                    ]
                }
            },
            "allOf": [
                {
                    "if": {
                        "required": [
                            "total_count"
                        ]
                    },
                    "then": {
                        "required": [
                            "total_scope"
                        ]
                    }
                },
                {
                    "if": {
                        "required": [
                            "total_scope"
                        ]
                    },
                    "then": {
                        "required": [
                            "total_count"
                        ]
                    }
                }
            ]
        },
        "fixed_aliquot_specification": {
            "title": "Fixed Aliquot Specification",
            "description": "Source-specified count, scope, and dimensions for fixed aliquots.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "count",
                "count_scope",
                "dimensions_cm"
            ],
            "properties": {
                "count": {
                    "type": "integer",
                    "minimum": 1
                },
                "count_scope": {
                    "type": "string",
                    "enum": [
                        "per organ",
                        "per tissue",
                        "per half"
                    ]
                },
                "total_count": {
                    "type": "integer",
                    "minimum": 1
                },
                "total_scope": {
                    "type": "string",
                    "enum": [
                        "per organ",
                        "per bilateral organ"
                    ]
                },
                "dimensions_cm": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "length",
                        "width",
                        "full_thickness"
                    ],
                    "properties": {
                        "length": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "width": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "depth": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "full_thickness": {
                            "type": "boolean"
                        }
                    },
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "full_thickness": {
                                        "const": true
                                    }
                                }
                            },
                            "then": {
                                "not": {
                                    "required": [
                                        "depth"
                                    ]
                                }
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "full_thickness": {
                                        "const": false
                                    }
                                }
                            },
                            "then": {
                                "required": [
                                    "depth"
                                ]
                            }
                        }
                    ]
                }
            },
            "allOf": [
                {
                    "if": {
                        "required": [
                            "total_count"
                        ]
                    },
                    "then": {
                        "required": [
                            "total_scope"
                        ]
                    }
                },
                {
                    "if": {
                        "required": [
                            "total_scope"
                        ]
                    },
                    "then": {
                        "required": [
                            "total_count"
                        ]
                    }
                }
            ]
        },
        "aliquot_preparation_notes": {
            "title": "Aliquot Preparation Notes",
            "description": "Curated notes about preparation instructions not represented by counts and dimensions.",
            "type": "string"
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string",
                "suggested_enum": [
                    "tissue_subtype",
                    "tissue_type",
                    "germ_layer"
                ]
            }
        }
    },
    "columns": {
        "identifier": {
            "title": "Identifier"
        },
        "valid_protocol_ids": {
            "title": "Valid Protocol ID"
        }
    }
}
