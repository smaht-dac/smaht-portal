{
    "title": "Ontology Term",
    "$id": "/profiles/ontology_term.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "identifier",
        "title",
        "ontologies"
    ],
    "anyOf": [
        {
            "required": [
                "submission_centers"
            ]
        },
        {
            "required": [
                "consortia"
            ]
        }
    ],
    "identifyingProperties": [
        "aliases",
        "identifier",
        "uuid"
    ],
    "additionalProperties": false,
    "mixinProperties": [
        {
            "$ref": "mixins.json#/aliases"
        },
        {
            "$ref": "mixins.json#/attribution"
        },
        {
            "$ref": "mixins.json#/description"
        },
        {
            "$ref": "mixins.json#/identifier"
        },
        {
            "$ref": "mixins.json#/modified"
        },
        {
            "$ref": "mixins.json#/preferred_name"
        },
        {
            "$ref": "mixins.json#/schema_version"
        },
        {
            "$ref": "mixins.json#/status"
        },
        {
            "$ref": "mixins.json#/submitted"
        },
        {
            "$ref": "mixins.json#/tags"
        },
        {
            "$ref": "mixins.json#/title"
        },
        {
            "$ref": "mixins.json#/url"
        },
        {
            "$ref": "mixins.json#/uuid"
        }
    ],
    "properties": {
        "identifier": {
            "pattern": "^[A-Z]+:[0-9]+$"
        },
        "title": {
            "description": "Title of the ontology term"
        },
        "schema_version": {
            "default": "1"
        },
        "status": {
            "default": "open",
            "enum": [
                "released",
                "open",
                "in review",
                "obsolete",
                "deleted"
            ]
        },
        "description": {
            "description": "Description of the ontology term"
        },
        "ontologies": {
            "title": "Ontologies",
            "description": "Ontologies that this term is a part of",
            "type": "array",
            "items": {
                "type": "string",
                "linkTo": "Ontology"
            }
        },
        "url": {
            "description": "The url that uniquely identifies term - often purl."
        },
        "grouping_term": {
            "title": "Grouping Term",
            "description": "Ontology term that this term is grouped under - less specific term used in search",
            "type": "string",
            "linkTo": "OntologyTerm"
        },
        "valid_protocol_ids":{
            "title": "Valid Protocol IDs",
            "description": "Tissue protocol IDs that are valid for the ontology term - used to check that Uberon IDs are correctly linked to tissue items.",
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "internal_code": {
            "title": "Internal Code",
            "description": "Four-letter source-backed tissue code; not a protocol identifier.",
            "type": "string",
            "pattern": "^[A-Z]{4}$"
        },
        "standardized_recovery_description": {
            "title": "Standardized Recovery Description",
            "description": "Canonical description of the standardized tissue recovery location.",
            "type": "string"
        },
        "initial_tissue_configuration": {
            "title": "Initial Tissue Configuration",
            "description": "Curated description of the tissue configuration before aliquoting.",
            "type": "string"
        },
        "aliquot_specifications": {
            "title": "Aliquot Specifications",
            "description": "Source-preserving preservation and aliquot specifications; quantitative fields are optional when the source is unspecified or inapplicable.",
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "preservation",
                    "source_text",
                    "status"
                ],
                "properties": {
                    "preservation": {
                        "type": "string",
                        "enum": [
                            "Fixed",
                            "Snap Frozen",
                            "Fresh",
                            "Cultured Cells",
                            "Unspecified",
                            "Not applicable"
                        ]
                    },
                    "source_text": {
                        "type": "string",
                        "minLength": 1
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "normative",
                            "representative",
                            "unspecified",
                            "inapplicable"
                        ]
                    },
                    "variability": {
                        "type": "string",
                        "enum": [
                            "fixed",
                            "variable",
                            "unspecified"
                        ]
                    },
                    "count": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "count_unit": {
                        "type": "string",
                        "minLength": 1
                    },
                    "count_scope": {
                        "type": "string",
                        "enum": [
                            "per organ",
                            "per tissue",
                            "per half",
                            "per bilateral organ",
                            "per collection",
                            "per aliquot",
                            "aggregate"
                        ]
                    },
                    "total_count": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "total_scope": {
                        "type": "string",
                        "enum": [
                            "per organ",
                            "per tissue",
                            "per half",
                            "per bilateral organ",
                            "per collection",
                            "per aliquot",
                            "aggregate"
                        ]
                    },
                    "volumes": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "value",
                                "unit",
                                "scope"
                            ],
                            "properties": {
                                "value": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                },
                                "unit": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "scope": {
                                    "type": "string",
                                    "enum": [
                                        "per organ",
                                        "per tissue",
                                        "per half",
                                        "per bilateral organ",
                                        "per collection",
                                        "per aliquot",
                                        "aggregate"
                                    ]
                                }
                            }
                        }
                    },
                    "dimensions": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "unit",
                            "ordered"
                        ],
                        "properties": {
                            "unit": {
                                "type": "string",
                                "minLength": 1
                            },
                            "ordered": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "minProperties": 1,
                                    "maxProperties": 1,
                                    "properties": {
                                        "value": {
                                            "type": "number",
                                            "exclusiveMinimum": 0
                                        },
                                        "qualifier": {
                                            "type": "string",
                                            "const": "full_thickness"
                                        }
                                    }
                                },
                                "oneOf": [
                                    {
                                        "minItems": 1,
                                        "maxItems": 3,
                                        "items": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": [
                                                "value"
                                            ],
                                            "properties": {
                                                "value": {
                                                    "type": "number",
                                                    "exclusiveMinimum": 0
                                                }
                                            }
                                        }
                                    },
                                    {
                                        "minItems": 1,
                                        "maxItems": 1,
                                        "prefixItems": [
                                            {
                                                "type": "object",
                                                "additionalProperties": false,
                                                "required": [
                                                    "qualifier"
                                                ],
                                                "properties": {
                                                    "qualifier": {
                                                        "type": "string",
                                                        "const": "full_thickness"
                                                    }
                                                }
                                            }
                                        ],
                                        "items": false
                                    },
                                    {
                                        "minItems": 2,
                                        "maxItems": 2,
                                        "prefixItems": [
                                            {
                                                "type": "object",
                                                "additionalProperties": false,
                                                "required": [
                                                    "value"
                                                ],
                                                "properties": {
                                                    "value": {
                                                        "type": "number",
                                                        "exclusiveMinimum": 0
                                                    }
                                                }
                                            },
                                            {
                                                "type": "object",
                                                "additionalProperties": false,
                                                "required": [
                                                    "qualifier"
                                                ],
                                                "properties": {
                                                    "qualifier": {
                                                        "type": "string",
                                                        "const": "full_thickness"
                                                    }
                                                }
                                            }
                                        ],
                                        "items": false
                                    },
                                    {
                                        "minItems": 3,
                                        "maxItems": 3,
                                        "prefixItems": [
                                            {
                                                "type": "object",
                                                "additionalProperties": false,
                                                "required": [
                                                    "value"
                                                ],
                                                "properties": {
                                                    "value": {
                                                        "type": "number",
                                                        "exclusiveMinimum": 0
                                                    }
                                                }
                                            },
                                            {
                                                "type": "object",
                                                "additionalProperties": false,
                                                "required": [
                                                    "value"
                                                ],
                                                "properties": {
                                                    "value": {
                                                        "type": "number",
                                                        "exclusiveMinimum": 0
                                                    }
                                                }
                                            },
                                            {
                                                "type": "object",
                                                "additionalProperties": false,
                                                "required": [
                                                    "qualifier"
                                                ],
                                                "properties": {
                                                    "qualifier": {
                                                        "type": "string",
                                                        "const": "full_thickness"
                                                    }
                                                }
                                            }
                                        ],
                                        "items": false
                                    }
                                ]
                            }
                        }
                    },
                    "scope": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "kind"
                        ],
                        "properties": {
                            "kind": {
                                "type": "string",
                                "enum": [
                                    "per organ",
                                    "per tissue",
                                    "per half",
                                    "per bilateral organ",
                                    "per collection",
                                    "per aliquot",
                                    "aggregate"
                                ]
                            },
                            "owner": {
                                "type": "string",
                                "minLength": 1
                            },
                            "laterality": {
                                "type": "string",
                                "enum": [
                                    "left",
                                    "right",
                                    "bilateral",
                                    "unspecified"
                                ]
                            }
                        },
                        "allOf": [
                            {
                                "if": {
                                    "properties": {
                                        "kind": {
                                            "const": "aggregate"
                                        }
                                    },
                                    "required": [
                                        "kind"
                                    ]
                                },
                                "then": {
                                    "required": [
                                        "owner"
                                    ]
                                }
                            }
                        ]
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "required": [
                                "count"
                            ]
                        },
                        "then": {
                            "required": [
                                "count_unit",
                                "count_scope"
                            ]
                        }
                    },
                    {
                        "if": {
                            "required": [
                                "total_count"
                            ]
                        },
                        "then": {
                            "required": [
                                "count_unit",
                                "total_scope"
                            ]
                        }
                    },
                    {
                        "if": {
                            "required": [
                                "count_unit"
                            ]
                        },
                        "then": {
                            "anyOf": [
                                {
                                    "required": [
                                        "count"
                                    ]
                                },
                                {
                                    "required": [
                                        "total_count"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "if": {
                            "required": [
                                "count_scope"
                            ]
                        },
                        "then": {
                            "required": [
                                "count"
                            ]
                        }
                    },
                    {
                        "if": {
                            "required": [
                                "total_scope"
                            ]
                        },
                        "then": {
                            "required": [
                                "total_count"
                            ]
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "count_scope": {
                                    "const": "aggregate"
                                }
                            },
                            "required": [
                                "count_scope"
                            ]
                        },
                        "then": {
                            "required": [
                                "scope"
                            ],
                            "properties": {
                                "scope": {
                                    "properties": {
                                        "kind": {
                                            "const": "aggregate"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "total_scope": {
                                    "const": "aggregate"
                                }
                            },
                            "required": [
                                "total_scope"
                            ]
                        },
                        "then": {
                            "required": [
                                "scope"
                            ],
                            "properties": {
                                "scope": {
                                    "properties": {
                                        "kind": {
                                            "const": "aggregate"
                                        }
                                    }
                                }
                            }
                        }
                    }
                ]
            }
        },
        "aliquot_preparation_notes": {
            "title": "Aliquot Preparation Notes",
            "description": "Curated notes about preparation instructions not represented by structured aliquot specifications.",
            "type": "string"
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string",
                "suggested_enum": [
                    "tissue_subtype",
                    "tissue_type",
                    "germ_layer"
                ]
            }
        }
    },
    "columns": {
        "identifier": {
            "title": "Identifier"
        },
        "valid_protocol_ids": {
            "title": "Valid Protocol ID"
        }
    }
}
